<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PreferenceSpecifiers</key>
	<array>
		<dict>
			<key>FooterText</key>
			<string>Streaming controls affect audio played from your server, not downloaded music. Quality changes apply to the next stream, not during playback. Auto uses Original on unmetered Wi-Fi or wired connections, AAC up to 192 kbps on cellular, costly or unknown paths, and 128 kbps on constrained paths. Connection type is used, not measured speed. Unknown connections use Cellular Quality.</string>
			<key>Title</key>
			<string>Streaming</string>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
		</dict>
		<dict>
			<key>DefaultValue</key>
			<string>original</string>
			<key>Key</key>
			<string>audio.streaming.wifiQuality</string>
			<key>Title</key>
			<string>Wi-Fi &amp; Wired Quality</string>
			<key>Type</key>
			<string>PSMultiValueSpecifier</string>
			<key>Titles</key>
			<array>
				<string>Original</string>
				<string>Auto</string>
				<string>High · 320 kbps</string>
				<string>Standard · 192 kbps</string>
				<string>Data Saver · 128 kbps</string>
			</array>
			<key>Values</key>
			<array>
				<string>original</string>
				<string>auto</string>
				<string>aac320</string>
				<string>aac192</string>
				<string>aac128</string>
			</array>
		</dict>
		<dict>
			<key>DefaultValue</key>
			<string>auto</string>
			<key>Key</key>
			<string>audio.streaming.cellularQuality</string>
			<key>Title</key>
			<string>Cellular Quality</string>
			<key>Type</key>
			<string>PSMultiValueSpecifier</string>
			<key>Titles</key>
			<array>
				<string>Original</string>
				<string>Auto</string>
				<string>High · 320 kbps</string>
				<string>Standard · 192 kbps</string>
				<string>Data Saver · 128 kbps</string>
			</array>
			<key>Values</key>
			<array>
				<string>original</string>
				<string>auto</string>
				<string>aac320</string>
				<string>aac192</string>
				<string>aac128</string>
			</array>
		</dict>
		<dict>
			<key>DefaultValue</key>
			<true/>
			<key>Key</key>
			<string>audio.streaming.allowCellular</string>
			<key>Title</key>
			<string>Allow Cellular Streaming</string>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
		</dict>
		<dict>
			<key>FooterText</key>
			<string>Quality applies to new downloads. Existing files are kept. AAC conversion requires server permission. Manage downloaded music and storage in VelaCanto Settings.</string>
			<key>Title</key>
			<string>Downloads</string>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
		</dict>
		<dict>
			<key>DefaultValue</key>
			<string>original</string>
			<key>Key</key>
			<string>audio.downloads.quality</string>
			<key>Title</key>
			<string>Quality</string>
			<key>Type</key>
			<string>PSMultiValueSpecifier</string>
			<key>Titles</key>
			<array>
				<string>Original</string>
				<string>High · 320 kbps</string>
				<string>Standard · 192 kbps</string>
				<string>Data Saver · 128 kbps</string>
			</array>
			<key>Values</key>
			<array>
				<string>original</string>
				<string>aac320</string>
				<string>aac192</string>
				<string>aac128</string>
			</array>
		</dict>
		<dict>
			<key>DefaultValue</key>
			<false/>
			<key>Key</key>
			<string>audio.downloads.allowCellular</string>
			<key>Title</key>
			<string>Allow Cellular Downloads</string>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
		</dict>
	</array>
	<key>StringsTable</key>
	<string>Root</string>
